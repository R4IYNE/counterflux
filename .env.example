# Counterflux — local environment template (D-03, D-04).
# Copy to .env.local (gitignored via *.local) and fill in real values.
# Production + preview values live in Vercel project env vars, NOT in git.
#
# Provisioning runbook: .planning/phases/10-supabase-auth-foundation/10-AUTH-PREFLIGHT.md
# v1.3 AI infra runbook: .planning/milestones/v1.3-PRD.md

# Supabase (client-bundled — anon key is RLS-protected and safe to ship)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 17 (v1.3) — Anthropic API key for /api/deckgen.
# SERVER-ONLY. Never reaches the browser. Set in Vercel project env vars
# (Production + Preview + Development). Local dev: copy your key from
# console.anthropic.com into .env.local. /api/deckgen will return 500 with
# a runbook link if this var is missing.
ANTHROPIC_API_KEY=

# Phase 19 (v1.3) — Supabase service-role key for the upgrade-scan cron.
# SERVER-ONLY. Used ONLY by api/cron/deckgen-upgrade-scan.js to query all
# users' decks for new-card detection. Not required by /api/deckgen — the
# user-facing endpoints use the caller's JWT, not service-role.
SUPABASE_SERVICE_ROLE_KEY=
